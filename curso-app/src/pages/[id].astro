---
// Uma página por módulo, apoio, projeto final, prática e gabarito.
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Titulo from '../componentes/Titulo.astro';
import Ficha from '../componentes/Ficha.astro';
import Avisos from '../componentes/Avisos.astro';
import Sequencia from '../componentes/Sequencia.astro';
import { cursoValidado, percurso, type EntradaDoCurso } from '../conteudo/carregar';
import { tituloSimples } from '../conteudo/titulo';
import { textos } from '../textos';

export async function getStaticPaths() {
  const curso = await cursoValidado();
  return [...curso.values()]
    .map((e) => ({ params: { id: e.dados.id } }));
}

const curso = await cursoValidado();
const entrada = curso.get(Astro.params.id!) as EntradaDoCurso;
const d = entrada.dados;
const { Content } = await render(entrada);

const sequencia = await percurso();
const posicao = sequencia.findIndex((e) => e.dados.id === d.id);
const anterior = posicao > 0 ? sequencia[posicao - 1] : undefined;
const proximo = posicao >= 0 ? sequencia[posicao + 1] : undefined;
const modulo = d.tipo === 'pratica' ? curso.get(d.pratica_de) : undefined;
const entradaGabarito = d.tipo === 'modulo' || d.tipo === 'apoio' || d.tipo === 'projeto' ? curso.get(d.gabarito ?? '') : undefined;
const conteudoAssociado = d.tipo === 'gabarito' ? curso.get(d.gabarito_de[0] ?? '') : undefined;
---
<Base titulo={tituloSimples(d.titulo)}>
  <nav aria-label="Caminho de navegação" class="breadcrumb">
    <a href="/">Apresentação</a> · <a href="/mapa/">Mapa dos módulos</a> · <span aria-current="page">{tituloSimples(d.titulo)}</span>
  </nav>
  <Titulo titulo={d.titulo} />
  {d.tipo === 'gabarito' ? (
    <>
      <p class="aviso" role="note">Este arquivo foi escrito originalmente como gabarito do professor. Considere esse contexto ao consultar a resposta.</p>
      <details class="gabarito">
        <summary>Mostrar o gabarito. Se quiser preservar a tentativa, faça primeiro a atividade no local indicado no módulo.</summary>
        <Ficha entrada={entrada} curso={curso} />
        <Content />
      </details>
      {conteudoAssociado && <p><a href={`/${conteudoAssociado.dados.id}/`}>Voltar ao conteúdo associado</a></p>}
    </>
  ) : (
    <>
      <Ficha entrada={entrada} curso={curso} />
      {d.tipo === 'projeto' && <Avisos />}
      {d.tipo === 'pratica' && <p class="aviso" role="note">{textos.notaDaPratica}</p>}
      <Content />
      {entradaGabarito?.dados.tipo === 'gabarito' && <p><a href={`/${entradaGabarito.dados.id}/`}>Ir ao gabarito, depois de tentar no local indicado</a></p>}
      {modulo && <p><a href={`/${modulo.dados.id}/`}>{textos.voltarAoModulo(tituloSimples(modulo.dados.titulo))}</a></p>}
      {posicao >= 0 && <Sequencia anterior={anterior} proximo={proximo} />}
    </>
  )}
</Base>
