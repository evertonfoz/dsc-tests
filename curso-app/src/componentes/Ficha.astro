---
// Ficha da página, gerada do front matter (plano do M1, seção 3): tipo, duração, pré-requisitos, prática.
import { textos } from '../textos';
import TextoComCodigo from './TextoComCodigo.astro';
import type { EntradaDoCurso } from '../conteudo/carregar';

interface Props {
  entrada: EntradaDoCurso;
  curso: Map<string, EntradaDoCurso>;
}
const { entrada, curso } = Astro.props;
const d = entrada.dados;
const alvo = (id: string) => ({ href: `/${id}/`, titulo: curso.get(id)?.dados.titulo ?? id });
const percurso = d.tipo === 'modulo' || d.tipo === 'apoio' || d.tipo === 'projeto' ? d : null;
const pede = percurso?.prerequisitos.map(alvo) ?? [];
const sePrecisar = percurso?.prerequisitos_se_precisar?.map(alvo) ?? [];
const pratica = percurso?.pratica ? alvo(percurso.pratica) : null;
---
<dl class="ficha">
  <dt>{textos.tipo}</dt>
  <dd>{textos.tipos[d.tipo] ?? d.tipo}</dd>
  {percurso && (
    <>
      <dt>{textos.duracao}</dt>
      <dd>{percurso.duracao} <span class="nota">({textos.duracaoNota})</span></dd>
      <dt>{textos.pede}</dt>
      <dd>
        {pede.length === 0 ? textos.pedeNada : (
          <ul>{pede.map((p) => <li><a href={p.href}><TextoComCodigo texto={p.titulo} /></a></li>)}</ul>
        )}
      </dd>
    </>
  )}
  {sePrecisar.length > 0 && (
    <>
      <dt>{textos.sePrecisar}</dt>
      <dd><ul>{sePrecisar.map((p) => <li><a href={p.href}><TextoComCodigo texto={p.titulo} /></a></li>)}</ul></dd>
    </>
  )}
  {pratica && (
    <>
      <dt>{textos.pratica}</dt>
      <dd><a href={pratica.href} data-onboarding-href={pratica.href}><TextoComCodigo texto={pratica.titulo} /></a></dd>
    </>
  )}
</dl>
