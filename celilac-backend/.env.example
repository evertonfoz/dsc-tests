# Copie para `.env` (arquivo ignorado pelo git) e preencha. Nunca commite o `.env`.
# As senhas são OBRIGATÓRIAS e não têm valor padrão no compose.yaml.

# --- Banco de desenvolvimento (usado pela API) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=celilac_user
DB_PASSWORD=
DB_NAME=celilac_db

# --- Banco de testes (exclusivo: usuário, banco e porta distintos do desenvolvimento) ---
# O nome do banco de testes deve terminar em _test.
TEST_DB_HOST=localhost
TEST_DB_PORT=5435
TEST_DB_USERNAME=celilac_test
TEST_DB_PASSWORD=
TEST_DB_NAME=celilac_test
# Só mude para true para permitir TRUNCATE/migrations no banco de TESTES.
TEST_DB_ALLOW_DESTRUCTIVE=false

# --- Compose ---
COMPOSE_PROJECT_NAME=celilac
