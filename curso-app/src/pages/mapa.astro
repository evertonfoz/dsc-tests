---
// A sequência linear é a navegação principal; o grafo complementa a lista.
import Base from '../layouts/Base.astro';
import TextoComCodigo from '../componentes/TextoComCodigo.astro';
import { cursoValidado, percurso } from '../conteudo/carregar';
import { textos } from '../textos';
import Grafo from '../componentes/Grafo.astro';

const curso = await cursoValidado();
const itens = await percurso();
const titulo = (id: string) => curso.get(id)?.dados.titulo ?? id;
---
<Base titulo={textos.tituloMapa}>
  <h1>{textos.tituloMapa}</h1>
  <p>{textos.introducaoMapa}</p>
  <h2>{textos.tituloListaMapa}</h2>
  <ol class="mapa" data-mapa>
    {itens.map((e) => (
      <li data-id={e.dados.id}>
        <p class="tipo-pagina">{textos.tipos[e.dados.tipo] ?? e.dados.tipo}</p>
        <a href={`/${e.dados.id}/`}><TextoComCodigo texto={e.dados.titulo} /></a>
        <dl>
          <dt>{textos.duracao}</dt>
          <dd>{e.dados.duracao} <span class="nota">({textos.duracaoNota})</span></dd>
          <dt>{textos.pede}</dt>
          <dd>
            {e.dados.prerequisitos.length === 0 ? textos.pedeNada : (
              <ul class="em-linha">
                {e.dados.prerequisitos.map((id) => <li><a href={`/${id}/`} data-pede={id}><TextoComCodigo texto={titulo(id)} /></a></li>)}
              </ul>
            )}
          </dd>
          {(e.dados.prerequisitos_se_precisar?.length ?? 0) > 0 && (
            <>
              <dt>{textos.sePrecisar}</dt>
              <dd>
                <ul class="em-linha">
                  {e.dados.prerequisitos_se_precisar!.map((id) => <li><a href={`/${id}/`} data-se-precisar={id}><TextoComCodigo texto={titulo(id)} /></a></li>)}
                </ul>
              </dd>
            </>
          )}
        </dl>
      </li>
    ))}
  </ol>
  <details class="mapa-grafo">
    <summary>{textos.verDiagrama}</summary>
    <p>{textos.descricaoGrafo}</p>
    <Grafo itens={itens} titulo={textos.tituloGrafo} legendaObrigatorio={textos.legendaObrigatorio} legendaCondicional={textos.legendaCondicional} />
  </details>
</Base>
